<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MOSTAKBAL — Portail administratif</title>

<style>
:root{
  --blue:#0b5cff;
  --blue2:#1746b8;
  --dark:#07111f;
  --text:#172033;
  --muted:#667085;
  --bg:#f4f7fb;
  --white:#ffffff;
  --border:#e4e9f1;
  --success:#16a34a;
  --warning:#d97706;
  --danger:#dc2626;
  --shadow:0 15px 45px rgba(15,35,70,.10);
  --radius:20px;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  background:var(--bg);
  color:var(--text);
}

button,input,select,textarea{
  font:inherit;
}

button{
  cursor:pointer;
}

.hidden{
  display:none!important;
}

#app{
  min-height:100vh;
}

.logo{
  display:flex;
  align-items:center;
  gap:12px;
  font-weight:800;
  font-size:20px;
}

.logo-mark{
  width:42px;
  height:42px;
  border-radius:13px;
  background:linear-gradient(135deg,#0b5cff,#43a5ff);
  display:grid;
  place-items:center;
  color:white;
  font-size:25px;
  font-weight:900;
  box-shadow:0 8px 20px rgba(11,92,255,.25);
}

.topbar{
  height:74px;
  background:white;
  border-bottom:1px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 5%;
  position:sticky;
  top:0;
  z-index:50;
}

.profile-button{
  border:0;
  background:#f1f5ff;
  width:45px;
  height:45px;
  border-radius:50%;
  font-size:20px;
}

.page{
  max-width:1200px;
  margin:auto;
  padding:45px 20px;
}

.hero{
  background:linear-gradient(135deg,#071a36,#0b5cff);
  color:white;
  border-radius:30px;
  padding:55px;
  box-shadow:var(--shadow);
  margin-bottom:30px;
}

.hero h1{
  font-size:clamp(34px,5vw,62px);
  line-height:1;
  margin-bottom:20px;
}

.hero p{
  max-width:700px;
  opacity:.88;
  font-size:18px;
  line-height:1.6;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:20px;
}

.card{
  background:white;
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:25px;
  box-shadow:0 8px 30px rgba(15,35,70,.06);
}

.card h3{
  margin:15px 0 8px;
}

.card p{
  color:var(--muted);
  line-height:1.5;
}

.service-icon{
  width:55px;
  height:55px;
  border-radius:16px;
  display:grid;
  place-items:center;
  background:#eef4ff;
  color:var(--blue);
  font-size:26px;
}

.btn{
  border:0;
  border-radius:13px;
  padding:13px 18px;
  font-weight:700;
  transition:.2s;
}

.btn:hover{
  transform:translateY(-2px);
}

.btn-primary{
  background:var(--blue);
  color:white;
}

.btn-secondary{
  background:#edf2f8;
  color:var(--text);
}

.btn-success{
  background:var(--success);
  color:white;
}

.btn-danger{
  background:var(--danger);
  color:white;
}

.actions{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top:20px;
}

.form-card{
  background:white;
  border-radius:25px;
  padding:30px;
  box-shadow:var(--shadow);
}

.form-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:18px;
}

.field{
  display:flex;
  flex-direction:column;
  gap:7px;
}

.field.full{
  grid-column:1/-1;
}

.field label{
  font-weight:700;
  font-size:14px;
}

.field input,
.field select,
.field textarea{
  border:1px solid var(--border);
  border-radius:12px;
  padding:13px;
  outline:none;
  background:#fbfcfe;
}

.field input:focus,
.field select:focus,
.field textarea:focus{
  border-color:var(--blue);
  box-shadow:0 0 0 3px rgba(11,92,255,.10);
}

.stepper{
  display:flex;
  gap:8px;
  margin-bottom:25px;
  overflow:auto;
}

.step{
  min-width:130px;
  padding:10px 15px;
  border-radius:12px;
  background:#e9eef5;
  color:#667085;
  text-align:center;
  font-size:13px;
  font-weight:700;
}

.step.active{
  background:var(--blue);
  color:white;
}

.badge{
  display:inline-flex;
  padding:6px 10px;
  border-radius:999px;
  font-size:12px;
  font-weight:800;
}

.badge-success{
  background:#dcfce7;
  color:#166534;
}

.badge-warning{
  background:#fef3c7;
  color:#92400e;
}

.badge-info{
  background:#dbeafe;
  color:#1e40af;
}

.document-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  padding:16px;
  border:1px solid var(--border);
  border-radius:15px;
  margin-bottom:10px;
  background:#fafcff;
}

.notification{
  padding:17px;
  border-left:4px solid var(--blue);
  background:white;
  border-radius:12px;
  margin-bottom:12px;
  box-shadow:0 5px 20px rgba(0,0,0,.04);
}

.table-wrap{
  overflow:auto;
}

table{
  width:100%;
  border-collapse:collapse;
  background:white;
}

th,td{
  padding:15px;
  border-bottom:1px solid var(--border);
  text-align:left;
}

th{
  background:#f7f9fc;
}

@media(max-width:700px){
  .hero{
    padding:30px 22px;
  }

  .form-grid{
    grid-template-columns:1fr;
  }

  .field.full{
    grid-column:auto;
  }

  .topbar{
    padding:0 18px;
  }
}
</style>
</head>

<body>
<div id="app"></div>

<script>
const MOSTAKBAL = {
  state:{
    screen:"home",
    space:null,
    procedure:null,
    form:{},
    files:[],
    requests:[],
    notifications:[],
    currentRequest:null,
    admin:{
      identifier:"admin",
      password:"admin"
    }
  },

  go(screen,data={}){
    this.state.screen=screen;

    if(data.space!==undefined) this.state.space=data.space;
    if(data.procedure!==undefined) this.state.procedure=data.procedure;
    if(data.request!==undefined) this.state.currentRequest=data.request;

    render();
    window.scrollTo({top:0,behavior:"smooth"});
  }
};

function logoHTML(){
  return `
    <div class="logo">
      <div class="logo-mark">M</div>
      <span>MOSTAKBAL</span>
    </div>
  `;
}

function topbar(){
  return `
    <header class="topbar">
      ${logoHTML()}
      <button class="profile-button" onclick="MOSTAKBAL.go('profile')">◉</button>
    </header>
  `;
}
</script>
<script>
function homePage(){
  return `
    ${topbar()}

    <main class="page">
      <section class="hero">
        <div style="font-size:14px;font-weight:800;opacity:.8;margin-bottom:12px">
          PORTAIL ADMINISTRATIF NUMÉRIQUE
        </div>

        <h1>MOSTAKBAL</h1>

        <p>
          Vos démarches administratives, vos documents et le suivi de vos demandes
          réunis dans un espace numérique moderne.
        </p>

        <div class="actions">
          <button class="btn btn-primary"
            onclick="MOSTAKBAL.go('spaces')">
            Commencer une démarche
          </button>

          <button class="btn btn-secondary"
            onclick="MOSTAKBAL.go('notifications')">
            Mes notifications
          </button>
        </div>
      </section>

      <h2 style="margin-bottom:18px">Choisissez votre espace</h2>

      <div class="grid">

        <div class="card">
          <div class="service-icon">◎</div>
          <h3>Espace étranger</h3>
          <p>
            Titres, carte de statut, titre d'identité pour mineur étranger,
            naturalisation et démarches associées.
          </p>
          <div class="actions">
            <button class="btn btn-primary"
              onclick="MOSTAKBAL.go('foreign')">
              Accéder
            </button>
          </div>
        </div>

        <div class="card">
          <div class="service-icon">▣</div>
          <h3>Espace citoyen</h3>
          <p>
            CNI, passeport, extrait de naissance, carte sportive et passe santé M.
          </p>
          <div class="actions">
            <button class="btn btn-primary"
              onclick="MOSTAKBAL.go('citizen')">
              Accéder
            </button>
          </div>
        </div>

        <div class="card">
          <div class="service-icon">V</div>
          <h3>Service visa</h3>
          <p>
            Déposer et suivre une demande de visa avec dépôt des documents.
          </p>
          <div class="actions">
            <button class="btn btn-primary"
              onclick="MOSTAKBAL.go('visa')">
              Accéder
            </button>
          </div>
        </div>

        <div class="card">
          <div class="service-icon">A</div>
          <h3>Espace administratif</h3>
          <p>
            Consultation des dossiers, instruction, demandes de complément,
            décisions et gestion des demandes.
          </p>
          <div class="actions">
            <button class="btn btn-primary"
              onclick="MOSTAKBAL.go('admin')">
              Accéder
            </button>
          </div>
        </div>

      </div>
    </main>
  `;
}

function spacesPage(){
  return `
    ${topbar()}

    <main class="page">
      <div class="form-card">
        <h1>Choisir une démarche</h1>
        <p style="color:var(--muted);margin-top:8px">
          Sélectionnez le service correspondant à votre demande.
        </p>

        <div class="grid" style="margin-top:25px">

          <div class="card">
            <h3>Service visa</h3>
            <button class="btn btn-primary"
              onclick="MOSTAKBAL.go('visa')">
              Voir les demandes
            </button>
          </div>

          <div class="card">
            <h3>Service étranger</h3>
            <button class="btn btn-primary"
              onclick="MOSTAKBAL.go('foreign')">
              Voir les demandes
            </button>
          </div>

          <div class="card">
            <h3>Service citoyen</h3>
            <button class="btn btn-primary"
              onclick="MOSTAKBAL.go('citizen')">
              Voir les demandes
            </button>
          </div>

          <div class="card">
            <h3>Espace administratif</h3>
            <button class="btn btn-primary"
              onclick="MOSTAKBAL.go('admin')">
              Ouvrir
            </button>
          </div>

        </div>
      </div>
    </main>
  `;
}
</script>
<script>
function citizenPage(){
  return `
    ${topbar()}

    <main class="page">
      <div class="form-card">
        <h1>Service citoyen</h1>
        <p style="color:var(--muted);margin:8px 0 25px">
          Sélectionnez votre démarche.
        </p>

        <div class="grid">

          <div class="card">
            <div class="service-icon">C</div>
            <h3>Carte Nationale d'Identité</h3>
            <p>Première demande ou renouvellement.</p>

            <div class="actions">
              <button class="btn btn-primary"
                onclick="chooseProcedure('CNI - Première demande')">
                Première demande
              </button>

              <button class="btn btn-secondary"
                onclick="chooseProcedure('CNI - Renouvellement')">
                Renouvellement
              </button>
            </div>
          </div>

          <div class="card">
            <div class="service-icon">P</div>
            <h3>Passeport</h3>
            <p>Demandez ou renouvelez votre passeport.</p>

            <div class="actions">
              <button class="btn btn-primary"
                onclick="chooseProcedure('Passeport - Première demande')">
                Première demande
              </button>

              <button class="btn btn-secondary"
                onclick="chooseProcedure('Passeport - Renouvellement')">
                Renouvellement
              </button>
            </div>
          </div>

          <div class="card">
            <div class="service-icon">N</div>
            <h3>Extrait de naissance</h3>
            <p>
              Formulaire avec vos informations d'état civil.
            </p>

            <button class="btn btn-primary"
              onclick="chooseProcedure('Extrait de naissance')">
              Faire la demande
            </button>
          </div>

          <div class="card">
            <div class="service-icon">S</div>
            <h3>Carte sportive</h3>
            <p>Demande de carte sportive.</p>

            <button class="btn btn-primary"
              onclick="chooseProcedure('Carte sportive')">
              Faire la demande
            </button>
          </div>

          <div class="card">
            <div class="service-icon">M</div>
            <h3>Passe santé M</h3>
            <p>
              Demande destinée aux personnes remplissant les conditions requises.
            </p>

            <button class="btn btn-primary"
              onclick="chooseProcedure('Passe santé M')">
              Faire la demande
            </button>
          </div>

        </div>
      </div>
    </main>
  `;
}

function chooseProcedure(name){
  MOSTAKBAL.state.procedure=name;
  MOSTAKBAL.state.form={};
  MOSTAKBAL.state.files=[];
  MOSTAKBAL.go('procedure');
}
</script>
<script>
function foreignPage(){
  return `
    ${topbar()}

    <main class="page">
      <div class="form-card">
        <h1>Service étranger</h1>

        <p style="color:var(--muted);margin:8px 0 25px">
          Démarches relatives au séjour et à la situation administrative.
        </p>

        <div class="grid">

          <div class="card">
            <div class="service-icon">S</div>
            <h3>Carte de statut — motif stagiaire</h3>
            <button class="btn btn-primary"
              onclick="chooseProcedure('Carte de statut - motif stagiaire')">
              Faire la demande
            </button>
          </div>

          <div class="card">
            <div class="service-icon">T</div>
            <h3>Carte de statut — motif travail</h3>
            <button class="btn btn-primary"
              onclick="chooseProcedure('Carte de statut - motif travail')">
              Faire la demande
            </button>
          </div>

          <div class="card">
            <div class="service-icon">R</div>
            <h3>Carte de statut expirée — renouvellement</h3>
            <button class="btn btn-primary"
              onclick="chooseProcedure('Carte de statut expirée - renouvellement')">
              Faire la demande
            </button>
          </div>

          <div class="card">
            <div class="service-icon">T</div>
            <h3>Titre d'identité pour mineur étranger</h3>

            <button class="btn btn-primary"
              onclick="chooseProcedure('Titre d’identité pour mineur étranger')">
              Faire la demande
            </button>
          </div>

          <div class="card">
            <div class="service-icon">N</div>
            <h3>Demande de nationalité</h3>
            <p>
              Résidence minimale de trois ans selon les conditions du portail.
            </p>

            <button class="btn btn-primary"
              onclick="chooseProcedure('Demande de nationalité')">
              Faire la demande
            </button>
          </div>

          <div class="card">
            <div class="service-icon">M</div>
            <h3>Passe santé M</h3>
            <p>
              Pour un étranger : TIME ou carte de statut.
            </p>

            <button class="btn btn-primary"
              onclick="chooseProcedure('Passe santé M - étranger')">
              Faire la demande
            </button>
          </div>

        </div>
      </div>
    </main>
  `;
}

function visaPage(){
  return `
    ${topbar()}

    <main class="page">
      <div class="form-card">
        <h1>Service visa</h1>

        <p style="color:var(--muted);margin:8px 0 25px">
          Déposez votre demande de visa et transmettez les documents nécessaires.
        </p>

        <div class="card">
          <div class="service-icon">V</div>
          <h3>Demande de visa</h3>
          <p>
            Passeport, photographie, assurance et justificatif relatif
            au motif du voyage.
          </p>

          <button class="btn btn-primary"
            onclick="chooseProcedure('Demande de visa')">
            Commencer la demande
          </button>
        </div>
      </div>
    </main>
  `;
}
</script>
<script>
function procedurePage(){
  return `
    ${topbar()}

    <main class="page">

      <div class="stepper">
        <div class="step active">1. Formulaire</div>
        <div class="step">2. Documents</div>
        <div class="step">3. Récapitulatif</div>
        <div class="step">4. Confirmation</div>
      </div>

      <div class="form-card">
        <h1>${MOSTAKBAL.state.procedure}</h1>

        <p style="color:var(--muted);margin:8px 0 25px">
          Commencez votre demande puis complétez le formulaire.
        </p>

        <button class="btn btn-primary"
          onclick="MOSTAKBAL.go('form')">
          Commencer
        </button>
      </div>

    </main>
  `;
}

function formPage(){
  const p=MOSTAKBAL.state.procedure;

  let fields=`
    <div class="field">
      <label>Nom</label>
      <input id="nom" type="text">
    </div>

    <div class="field">
      <label>Prénom</label>
      <input id="prenom" type="text">
    </div>

    <div class="field">
      <label>Date de naissance</label>
      <input id="naissance" type="date">
    </div>

    <div class="field">
      <label>Numéro d'identification</label>
      <input id="identifiant" type="text">
    </div>

    <div class="field">
      <label>Numéro de téléphone</label>
      <input id="telephone" type="tel">
    </div>

    <div class="field">
      <label>Adresse mail</label>
      <input id="email" type="email">
    </div>
  `;

  if(p==="Extrait de naissance"){
    fields=`
      <div class="field">
        <label>Nom</label>
        <input id="nom" type="text">
      </div>

      <div class="field">
        <label>Prénom</label>
        <input id="prenom" type="text">
      </div>

      <div class="field">
        <label>Date de naissance</label>
        <input id="naissance" type="date">
      </div>

      <div class="field">
        <label>Lieu de naissance</label>
        <input id="lieu" type="text">
      </div>

      <div class="field">
        <label>NIN</label>
        <input id="nin" type="text">
      </div>

      <div class="field">
        <label>Numéro de téléphone</label>
        <input id="telephone" type="tel">
      </div>

      <div class="field">
        <label>Adresse mail</label>
        <input id="email" type="email">
      </div>
    `;
  }

  if(p==="Demande de nationalité"){
    fields+=`
      <div class="field full">
        <label>Durée de résidence</label>
        <input id="residence" type="number" min="0"
          placeholder="Nombre d'années">
      </div>
    `;
  }

  return `
    ${topbar()}

    <main class="page">

      <div class="stepper">
        <div class="step active">1. Formulaire</div>
        <div class="step">2. Documents</div>
        <div class="step">3. Récapitulatif</div>
        <div class="step">4. Confirmation</div>
      </div>

      <div class="form-card">
        <h1>Formulaire</h1>

        <p style="color:var(--muted);margin:8px 0 25px">
          ${p}
        </p>

        <div class="form-grid">
          ${fields}
        </div>

        <div class="actions">
          <button class="btn btn-secondary"
            onclick="MOSTAKBAL.go('procedure')">
            Retour
          </button>

          <button class="btn btn-primary"
            onclick="saveForm()">
            Continuer
          </button>
        </div>
      </div>

    </main>
  `;
}

function saveForm(){
  const ids=[
    "nom","prenom","naissance","lieu","nin",
    "telephone","email","identifiant","residence"
  ];

  MOSTAKBAL.state.form={};

  ids.forEach(id=>{
    const el=document.getElementById(id);
    if(el) MOSTAKBAL.state.form[id]=el.value;
  });

  MOSTAKBAL.go('documents');
}
</script>
<script>
function requiredDocuments(procedure){

  const docs={
    "CNI - Première demande":[
      "Pièce d'identité",
      "Acte de naissance délivré par les autorités internes",
      "Acquisition de nationalité",
      "Photo d'identité"
    ],

    "CNI - Renouvellement":[
      "Ancienne CNI",
      "Acte de naissance délivré par les autorités internes",
      "Photo d'identité"
    ],

    "Passeport - Première demande":[
      "Pièce d'identité",
      "Acquisition de nationalité",
      "NIN",
      "Photo d'identité"
    ],

    "Passeport - Renouvellement":[
      "Ancien passeport",
      "CNI",
      "Nouvelle photo"
    ],

    "Carte sportive":[
      "Pièce d'identité",
      "Photo d'identité",
      "Justificatif d'assurance"
    ],

    "Passe santé M":[
      "CNI ou passeport ou confirmation de dépôt",
      "Justificatif d'assurance"
    ],

    "Passe santé M - étranger":[
      "TIME ou carte de statut",
      "Justificatif d'assurance"
    ],

    "Demande de visa":[
      "Passeport",
      "Photo d'identité",
      "Justificatif d'assurance",
      "Document relatif au motif du voyage"
    ],

    "Carte de statut - motif stagiaire":[
      "Pièce d'identité",
      "Passeport",
      "Document relatif au stage",
      "Justificatif d'assurance"
    ],

    "Carte de statut - motif travail":[
      "Pièce d'identité",
      "Passeport",
      "Document relatif au travail",
      "Justificatif d'assurance"
    ],

    "Carte de statut expirée - renouvellement":[
      "Carte de statut expirée",
      "Passeport",
      "Justificatif d'assurance",
      "Document relatif à la situation actuelle"
    ],

    "Titre d’identité pour mineur étranger":[
      "Pièce d'identité d'origine",
      "Acte de naissance délivré par les autorités étrangères",
      "Visa",
      "Justificatif du lien avec le représentant légal"
    ],

    "Demande de nationalité":[
      "Pièce d'identité",
      "Acte de naissance",
      "Justificatifs de résidence",
      "Justificatif d'assurance"
    ],

    "Extrait de naissance":[]
  };

  return docs[procedure] || [
    "Pièce d'identité",
    "Justificatif d'assurance"
  ];
}

function documentsPage(){

  const docs=requiredDocuments(MOSTAKBAL.state.procedure);

  if(MOSTAKBAL.state.procedure==="Extrait de naissance"){
    generateBirthCertificate();
    return `
      ${topbar()}
      <main class="page">
        <div class="form-card">
          <h1>Extrait de naissance</h1>
          <p style="color:var(--muted);margin:10px 0 25px">
            Votre document est généré directement.
          </p>

          <button class="btn btn-success"
            onclick="generateBirthCertificate()">
            Télécharger l'extrait de naissance PDF
          </button>

          <button class="btn btn-secondary"
            onclick="MOSTAKBAL.go('citizen')">
            Retour au service citoyen
          </button>
        </div>
      </main>
    `;
  }

  return `
    ${topbar()}

    <main class="page">

      <div class="stepper">
        <div class="step">1. Formulaire</div>
        <div class="step active">2. Documents</div>
        <div class="step">3. Récapitulatif</div>
        <div class="step">4. Confirmation</div>
      </div>

      <div class="form-card">
        <h1>Déposer les documents</h1>

        <p style="color:var(--muted);margin:8px 0 25px">
          Ajoutez les fichiers correspondant à votre demande.
        </p>

        <input
          id="files"
          type="file"
          multiple
          onchange="handleFiles(this.files)"
          style="margin-bottom:25px"
        >

        <div>
          ${docs.map(d=>`
            <div class="document-row">
              <strong>${d}</strong>
              <span class="badge badge-info">Document requis</span>
            </div>
          `).join("")}
        </div>

        <div id="uploadedFiles"></div>

        <div class="actions">
          <button class="btn btn-secondary"
            onclick="MOSTAKBAL.go('form')">
            Retour
          </button>

          <button class="btn btn-primary"
            onclick="MOSTAKBAL.go('summary')">
            Continuer
          </button>
        </div>
      </div>

    </main>
  `;
}

function handleFiles(files){
  MOSTAKBAL.state.files=[...files].map(file=>({
    name:file.name,
    size:file.size,
    type:file.type
  }));

  const box=document.getElementById("uploadedFiles");

  if(!box)return;

  box.innerHTML=MOSTAKBAL.state.files.map(file=>`
    <div class="document-row">
      <span>${file.name}</span>
      <span class="badge badge-success">Ajouté</span>
    </div>
  `).join("");
}
</script>
<script>
function summaryPage(){

  const f=MOSTAKBAL.state.form;
  const p=MOSTAKBAL.state.procedure;

  return `
    ${topbar()}

    <main class="page">

      <div class="stepper">
        <div class="step">1. Formulaire</div>
        <div class="step">2. Documents</div>
        <div class="step active">3. Récapitulatif</div>
        <div class="step">4. Confirmation</div>
      </div>

      <div class="form-card">

        <h1>Récapitulatif</h1>

        <div class="card" style="margin-top:20px">
          <h3>Démarche</h3>
          <p>${p}</p>
        </div>

        <div class="card" style="margin-top:15px">
          <h3>Informations</h3>

          <p><strong>Nom :</strong> ${f.nom || "—"}</p>
          <p><strong>Prénom :</strong> ${f.prenom || "—"}</p>
          <p><strong>Téléphone :</strong> ${f.telephone || "—"}</p>
          <p><strong>Email :</strong> ${f.email || "—"}</p>
        </div>

        <div class="card" style="margin-top:15px">
          <h3>Documents déposés</h3>
          <p>
            ${MOSTAKBAL.state.files.length}
            document(s) ajouté(s).
          </p>
        </div>

        <div class="actions">

          <button class="btn btn-secondary"
            onclick="MOSTAKBAL.go('documents')">
            Modifier
          </button>

          <button class="btn btn-success"
            onclick="submitRequest()">
            Déposer la demande
          </button>

        </div>

      </div>

    </main>
  `;
}

function submitRequest(){

  const now=new Date();

  const ref=
    "MSK-"+now.getFullYear()+"-"+
    Math.random().toString(36).substring(2,8).toUpperCase();

  const request={
    id:Date.now(),
    reference:ref,
    procedure:MOSTAKBAL.state.procedure,
    form:{...MOSTAKBAL.state.form},
    files:[...MOSTAKBAL.state.files],
    date:now.toLocaleString("fr-FR"),
    status:"Reçue par l'administration",
    decision:null
  };

  MOSTAKBAL.state.requests.unshift(request);
  MOSTAKBAL.state.currentRequest=request;

  MOSTAKBAL.state.notifications.unshift({
    id:Date.now(),
    title:"Demande reçue par l'administration",
    message:
      `Votre demande ${request.procedure} a été déposée.`,
    date:request.date,
    read:false
  });

  MOSTAKBAL.go("confirmation",{request});
}

function confirmationPage(){

  const r=MOSTAKBAL.state.currentRequest;

  return `
    ${topbar()}

    <main class="page">

      <div class="stepper">
        <div class="step">1. Formulaire</div>
        <div class="step">2. Documents</div>
        <div class="step">3. Récapitulatif</div>
        <div class="step active">4. Confirmation</div>
      </div>

      <div class="form-card" style="text-align:center">

        <div class="logo" style="justify-content:center;margin-bottom:25px">
          ${logoHTML()}
        </div>

        <h1>Demande déposée</h1>

        <p style="color:var(--muted);margin:10px 0 20px">
          Votre demande a bien été transmise au service compétent.
        </p>

        <div class="card" style="text-align:left">

          <p>
            <strong>Référence :</strong>
            ${r.reference}
          </p>

          <p>
            <strong>Démarche :</strong>
            ${r.procedure}
          </p>

          <p>
            <strong>Statut :</strong>
            <span class="badge badge-info">
              ${r.status}
            </span>
          </p>

        </div>

        <div class="actions" style="justify-content:center">

          <button class="btn btn-success"
            onclick="generateConfirmationPDF()">
            Télécharger la confirmation PDF
          </button>

          <button class="btn btn-primary"
            onclick="MOSTAKBAL.go('notifications')">
            Voir mes notifications
          </button>

          <button class="btn btn-secondary"
            onclick="MOSTAKBAL.go('home')">
            Retour à l'accueil
          </button>

        </div>

      </div>

    </main>
  `;
}
</script>
<script>
function escapePDF(text){
  return String(text || "")
    .replace(/\\/g,"\\\\")
    .replace(/\(/g,"\\(")
    .replace(/\)/g,"\\)");
}

function createSimplePDF(title,lines){

  let objects=[];

  objects.push(
    "<< /Type /Catalog /Pages 2 0 R >>"
  );

  objects.push(
    "<< /Type /Pages /Kids [3 0 R] /Count 1 >>"
  );

  objects.push(
    "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] " +
    "/Resources << /Font << /F1 5 0 R >> >> " +
    "/Contents 4 0 R >>"
  );

  let stream="BT\n";
  stream+="/F1 24 Tf\n";
  stream+="70 770 Td\n";
  stream+=`(${escapePDF(title)}) Tj\n`;
  stream+="/F1 12 Tf\n";
  stream+="0 -45 Td\n";

  lines.forEach(line=>{
    stream+=`(${escapePDF(line)}) Tj\n`;
    stream+="0 -24 Td\n";
  });

  stream+="ET";

  objects.push(
    `<< /Length ${stream.length} >>\nstream\n${stream}\nendstream`
  );

  objects.push(
    "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>"
  );

  let pdf="%PDF-1.4\n";
  let offsets=[0];

  objects.forEach((obj,i)=>{
    offsets[i+1]=pdf.length;
    pdf+=`${i+1} 0 obj\n${obj}\nendobj\n`;
  });

  const xref=pdf.length;

  pdf+="xref\n";
  pdf+=`0 ${objects.length+1}\n`;
  pdf+="0000000000 65535 f \n";

  for(let i=1;i<offsets.length;i++){
    pdf+=String(offsets[i]).padStart(10,"0")+" 00000 n \n";
  }

  pdf+="trailer\n";
  pdf+=`<< /Size ${objects.length+1} /Root 1 0 R >>\n`;
  pdf+="startxref\n";
  pdf+=xref+"\n";
  pdf+="%%EOF";

  const blob=new Blob([pdf],{type:"application/pdf"});
  const url=URL.createObjectURL(blob);

  const a=document.createElement("a");
  a.href=url;
  a.download=
    title.toLowerCase().replace(/[^a-z0-9]+/gi,"-")+".pdf";

  document.body.appendChild(a);
  a.click();
  a.remove();

  setTimeout(()=>URL.revokeObjectURL(url),3000);
}

function generateConfirmationPDF(){

  const r=MOSTAKBAL.state.currentRequest;

  createSimplePDF(
    "MOSTAKBAL — Confirmation de dépôt",
    [
      "M",
      "CONFIRMATION DE DEPOT",
      "",
      "Reference : "+r.reference,
      "Nom : "+(r.form.nom || ""),
      "Prenom : "+(r.form.prenom || ""),
      "Demarche : "+r.procedure,
      "Date : "+r.date,
      "Statut : "+r.status,
      "",
      "Document genere par le portail MOSTAKBAL."
    ]
  );
}

function generateBirthCertificate(){

  const f=MOSTAKBAL.state.form;

  createSimplePDF(
    "MOSTAKBAL — Extrait de naissance",
    [
      "M",
      "EXTRAIT DE NAISSANCE",
      "",
      "Nom : "+(f.nom || ""),
      "Prenom : "+(f.prenom || ""),
      "Date de naissance : "+(f.naissance || ""),
      "Lieu de naissance : "+(f.lieu || ""),
      "NIN : "+(f.nin || ""),
      "Telephone : "+(f.telephone || ""),
      "Email : "+(f.email || ""),
      "",
      "Document genere par le portail MOSTAKBAL."
    ]
  );
}
</script>
MOSTAKBAL.state.notifications.length
<script>
function render(){

  const app=document.getElementById("app");

  switch(MOSTAKBAL.state.screen){

    case "home":
      app.innerHTML=homePage();
      break;

    case "spaces":
      app.innerHTML=spacesPage();
      break;

    case "citizen":
      app.innerHTML=citizenPage();
      break;

    case "foreign":
      app.innerHTML=foreignPage();
      break;

    case "visa":
      app.innerHTML=visaPage();
      break;

    case "procedure":
      app.innerHTML=procedurePage();
      break;

    case "form":
      app.innerHTML=formPage();
      break;

    case "documents":
      app.innerHTML=documentsPage();
      break;

    case "summary":
      app.innerHTML=summaryPage();
      break;

    case "confirmation":
      app.innerHTML=confirmationPage();
      break;

    case "notifications":
      app.innerHTML=notificationsPage();
      break;

    case "profile":
      app.innerHTML=profilePage();
      break;

    case "admin":
      app.innerHTML=adminPage();
      break;

    case "adminRequests":
      app.innerHTML=adminRequestsPage();
      break;

    case "adminRequest":
      app.innerHTML=adminRequestPage();
      break;

    default:
      MOSTAKBAL.state.screen="home";
      app.innerHTML=homePage();
  }
}

window.addEventListener("load",()=>{
  render();
});
</script>

</body>
</html>
